# Descope MCP server OIDC config (from Agentic Identity Hub → MCP Servers)
DESCOPE_CONFIG_URL=https://api.descope.com/v1/apps/agentic/P.../M.../.well-known/openid-configuration

# Public URL of this MCP server (Render sets RENDER_EXTERNAL_URL automatically)
SERVER_URL=http://localhost:8000

# Optional: Descope management key for local development fallback
# DESCOPE_MANAGEMENT_KEY=

# Optional fallback for fetching Connection credentials without caller token
# Format: <PROJECT_ID>:<management-key-or-mcp-server-access-token>
# DESCOPE_MGMT_API_KEY=

# Descope Connections that store BigQuery service account JSON
BIGQUERY_READ_OUTBOUND_APP_ID=bigquery-read-cert
BIGQUERY_WRITE_OUTBOUND_APP_ID=bigquery-readwrite-cert
