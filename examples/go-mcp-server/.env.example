# Descope Project ID (required) — found in your Descope Console project overview
DESCOPE_PROJECT_ID=

# Address the HTTP server listens on (optional, defaults to :8080)
ADDR=:8080

# This server's externally-reachable base URL, advertised as the OAuth
# Protected Resource identifier (RFC 9728). Set this to your real public URL
# in any non-local deployment. (optional, defaults to http://localhost<ADDR>)
SERVER_URL=

# Descope's API base URL. Change only for custom regions or domains.
# (optional, defaults to https://api.descope.com)
DESCOPE_BASE_URL=

# Override the OAuth issuer URL advertised in the protected resource metadata
# document. Needed only for custom Descope domains — by default it's derived
# from DESCOPE_BASE_URL and DESCOPE_PROJECT_ID.
# (optional, defaults to derived value)
DESCOPE_ISSUER_URL=
