# Descope Project ID (required) — found in your Descope Console project overview
DESCOPE_PROJECT_ID=

# Address the HTTP server listens on (optional, defaults to :8080)
ADDR=:8080

# This server's externally-reachable base URL, advertised as the OAuth
# Protected Resource identifier (RFC 9728). Set this to your real public URL
# in any non-local deployment. (optional, defaults to http://localhost<ADDR>)
SERVER_URL=

# The OAuth issuer URL for this Descope project (required). No separate
# Console setup needed — just build it from your Project ID:
# https://api.descope.com/v1/apps/<ProjectID>. Advertised to clients in the
# protected resource metadata document, and also used to derive the Descope
# API base URL this server talks to (so it works with custom domains/regions
# too).
DESCOPE_ISSUER_URL=
